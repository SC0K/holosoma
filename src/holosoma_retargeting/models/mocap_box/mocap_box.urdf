<?xml version="1.0"?>
<robot name="mocap_box">
  <link name="mocap_box_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><mesh filename="mocap_box.obj" scale="1 1 1"/></geometry>
      <material name="mocap_object"><color rgba="0.65 0.55 0.35 0.85"/></material>
    </visual>
    <collision name="mocap_box">
      <geometry><mesh filename="mocap_box.obj" scale="1 1 1"/></geometry>
    </collision>
  </link>
</robot>
